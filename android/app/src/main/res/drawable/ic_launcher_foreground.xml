<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft gold radial glow behind everything -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="46">
                <item android:offset="0.0" android:color="#4DFFD700" />
                <item android:offset="1.0" android:color="#00FFD700" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Faint outer gold ring -->
    <path
        android:strokeColor="#1AFFD700"
        android:strokeWidth="1"
        android:fillColor="#00000000"
        android:pathData="M54,18 a36,36 0 1,1 0,72 a36,36 0 1,1 0,-72 Z" />

    <!-- Inner image preview (gold gradient) inside the phone frame -->
    <path android:pathData="M41.5,32 L66.5,32 a2,2 0 0,1 2,2 L68.5,56 a2,2 0 0,1 -2,2 L41.5,58 a2,2 0 0,1 -2,-2 L39.5,34 a2,2 0 0,1 2,-2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="39"
                android:startY="32"
                android:endX="69"
                android:endY="58">
                <item android:offset="0.0" android:color="#4DFFD700" />
                <item android:offset="1.0" android:color="#14FFD700" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Two content lines below the preview, inside the phone -->
    <path
        android:strokeColor="#8CFFD700"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M41.5,62.5 L66.5,62.5" />
    <path
        android:strokeColor="#4DFFD700"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M41.5,65.5 L55.5,65.5" />

    <!-- Phone frame outline -->
    <path
        android:strokeColor="#FFD700"
        android:strokeWidth="1.5"
        android:fillColor="#00000000"
        android:pathData="M42,28 L66,28 a4,4 0 0,1 4,4 L70,64 a4,4 0 0,1 -4,4 L42,68 a4,4 0 0,1 -4,-4 L38,32 a4,4 0 0,1 4,-4 Z" />

    <!-- Play/view dot — gold radial glow under it -->
    <path android:pathData="M40,80 L68,80 L68,94 L40,94 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="84"
                android:gradientRadius="11">
                <item android:offset="0.0" android:color="#80FFD700" />
                <item android:offset="1.0" android:color="#00FFD700" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Solid gold dot with upward triangle cut from it (play/view) -->
    <path
        android:fillColor="#FFD700"
        android:fillType="evenOdd"
        android:pathData="M54,79 a5,5 0 1,1 0,10 a5,5 0 1,1 0,-10 Z M54,81.4 L51.55,86 L56.45,86 Z" />
</vector>
