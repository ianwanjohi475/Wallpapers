<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft gold radial glow behind everything -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="48">
                <item android:offset="0.0" android:color="#66FFD700" />
                <item android:offset="1.0" android:color="#00FFD700" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Hexagon shield fill (gold to orange gradient, soft) -->
    <path android:pathData="M54,28 L75.2,40.25 L75.2,64.75 L54,77 L32.8,64.75 L32.8,40.25 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="32.8"
                android:startY="28"
                android:endX="75.2"
                android:endY="77">
                <item android:offset="0.0" android:color="#40FFD700" />
                <item android:offset="1.0" android:color="#26FF7300" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Hexagon shield stroke (bright gold to orange) -->
    <path
        android:strokeWidth="2.5"
        android:fillColor="#00000000"
        android:pathData="M54,28 L75.2,40.25 L75.2,64.75 L54,77 L32.8,64.75 L32.8,40.25 Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="32.8"
                android:startY="28"
                android:endX="75.2"
                android:endY="77">
                <item android:offset="0.0" android:color="#FFFFD700" />
                <item android:offset="1.0" android:color="#FFFF7300" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- White checkmark inside shield -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M44,54 L51,61 L64,46" />

    <!-- Three gold accent dots at the bottom -->
    <path
        android:fillColor="#FFFFD700"
        android:pathData="M47.4,86 a1.6,1.6 0 1,1 3.2,0 a1.6,1.6 0 1,1 -3.2,0 Z" />
    <path
        android:fillColor="#FFFFD700"
        android:pathData="M52.4,86 a1.6,1.6 0 1,1 3.2,0 a1.6,1.6 0 1,1 -3.2,0 Z" />
    <path
        android:fillColor="#FFFFD700"
        android:pathData="M57.4,86 a1.6,1.6 0 1,1 3.2,0 a1.6,1.6 0 1,1 -3.2,0 Z" />
</vector>
